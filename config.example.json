{
  "title": "File Hash Browser",
  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "allowed_hosts": ["localhost", "127.0.0.1", "[::1]"],
    "request_timeout_seconds": 30
  },
  "privacy": {
    "show_full_filename": false
  },
  "browse": {
    "show_hidden_files": false,
    "default_page_size": 200,
    "max_page_size": 500,
    "max_node_tokens": 250000
  },
  "hashing": {
    "parallel_tasks": 0,
    "chunk_size_bytes": 1048576,
    "max_files_per_job": 100000,
    "max_directory_depth": 256,
    "max_algorithms_per_job": 16,
    "max_selections_per_job": 1000,
    "max_active_jobs": 32,
    "queue_multiplier": 4
  },
  "plugins": {
    "directory": null,
    "enabled_algorithms": ["md5", "sha1", "sha256", "sha512"]
  },
  "data": {
    "database": "./data/file-hash-browser.sqlite3"
  },
  "roots": [
    {
      "id": "shared",
      "label": "共享文件",
      "path": "./example-files"
    }
  ]
}

